# Copy this file to .env on the DEV host and set mode 0600.
# Never reuse values from PROD and never commit the populated .env file.

# Stable, collision-resistant Compose resource prefix.
COMPOSE_PROJECT_NAME=linkedin-content-engine-n8n-dev

# Existing Dokploy/Traefik integration. Confirm both names on the DEV host.
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_CERT_RESOLVER=letsencrypt

# Public DEV identity.
N8N_HOST=n8n-dev.innovaq-ai.com
N8N_PROXY_HOPS=1

# DEV-only PostgreSQL database. Generate a unique random password.
POSTGRES_DB=n8n_dev
POSTGRES_USER=n8n_dev
POSTGRES_PASSWORD=

# Generate a new DEV-only key. Never copy the PROD n8n encryption key.
N8N_ENCRYPTION_KEY=

# Pre-provision the DEV owner to avoid an exposed first-run setup screen.
# N8N_INSTANCE_OWNER_PASSWORD_HASH must be a bcrypt hash, not plaintext.
N8N_INSTANCE_OWNER_EMAIL=
N8N_INSTANCE_OWNER_FIRST_NAME=
N8N_INSTANCE_OWNER_LAST_NAME=
N8N_INSTANCE_OWNER_PASSWORD_HASH=

# Safe default. Change to true only after review and least-privilege setup.
N8N_MCP_ACCESS_ENABLED=false

# Retention and VPS resource ceilings for this DEV stack.
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
N8N_MEMORY_LIMIT=1g
N8N_CPU_LIMIT=1.00
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=0.50
