{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:linkedin-content-engine:schema:linkedin-draft",
  "title": "LinkedInDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "candidateId",
    "version",
    "hook",
    "body",
    "cta",
    "finalText",
    "sourceReferences",
    "factualClaims",
    "contentPillar",
    "tone",
    "generatedAt",
    "model",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "hook": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "cta": { "type": ["string", "null"] },
    "finalText": { "type": "string", "minLength": 1 },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "url", "title"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string", "minLength": 1 }
        }
      }
    },
    "factualClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "supportingSourceIds", "verificationStatus"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "supportingSourceIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "verificationStatus": {
            "type": "string",
            "enum": ["SUPPORTED", "UNSUPPORTED", "NEEDS_VERIFICATION"]
          }
        }
      }
    },
    "contentPillar": { "type": "string", "minLength": 1 },
    "tone": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "model": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "DRAFTED",
        "IN_REVIEW",
        "REVISION_REQUESTED",
        "APPROVED",
        "REJECTED"
      ]
    }
  }
}
